    "vector_weight": 0.5
  },
  "vector_index": {
    "embedding_backend": "sentence-transformers",
    "model_name": "BAAI/bge-small-zh-v1.5",
    "normalize_embeddings": true,
    "metric": "inner_product_cosine"
  }
}
